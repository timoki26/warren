+
+export interface CodexCredentialOptions {
+	authPath?: string;
+}
+
+export function codexHostAuthPath(): string {
+	const configuredHome = process.env.CODEX_HOME?.trim();
+	const home =
+		configuredHome && configuredHome.length > 0 ? configuredHome : join(homedir(), ".codex");
+	return join(home, CODEX_AUTH_FILE);
+}
+
+export function codexSandboxHome(
+	workspacePath: string,
+	platform: NodeJS.Platform = process.platform,
+): string {
+	return platform === "linux"
+		? `/workspace/${CODEX_RUNTIME_HOME_DIR}`
+		: join(workspacePath, CODEX_RUNTIME_HOME_DIR);
+}
+
+export async function forwardCodexHostCredentials(
+	workspacePath: string,
+	options: CodexCredentialOptions = {},
+): Promise<void> {
+	const source = options.authPath ?? codexHostAuthPath();
+	if (!existsSync(source)) {
+		throw new Error(
+			`Codex credentials not found at ${source}; run \`codex login\` or configure CODEX_HOME`,
+		);
+	}
+	const runtimeHome = join(workspacePath, CODEX_RUNTIME_HOME_DIR);
+	await rm(runtimeHome, { recursive: true, force: true });
+	await mkdir(runtimeHome, { recursive: true });
+	await writeFile(join(runtimeHome, ".gitignore"), "*\n", { encoding: "utf8", mode: 0o600 });
+	const target = join(runtimeHome, CODEX_AUTH_FILE);
+	await copyFile(source, target);
+	await chmod(target, 0o600);
+}
+
+export async function persistCodexHostCredentials(
+	workspacePath: string,
+	options: CodexCredentialOptions = {},
+): Promise<void> {
+	const runtimeHome = join(workspacePath, CODEX_RUNTIME_HOME_DIR);
+	const refreshed = join(runtimeHome, CODEX_REFRESHED_AUTH_FILE);
+	try {
+		if (!existsSync(refreshed)) return;
+		const target = options.authPath ?? codexHostAuthPath();
+		const body = await readFile(refreshed);
+		await writeFile(target, body, { mode: 0o600 });
+		await chmod(target, 0o600);
+	} finally {
+		await rm(runtimeHome, { recursive: true, force: true });
+	}
+}
+
+export function parseCodexJsonl(line: string): RuntimeEvent[] {
+	const trimmed = line.trim();
+	if (trimmed.length === 0) return [];
+	let parsed: unknown;
+	try {
+		parsed = JSON.parse(trimmed);
+	} catch {
+		return [
+			{ kind: "text", stream: "stdout", payload: { text: line, parseError: "invalid JSON" } },
+		];
+	}
+	if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
+		return [{ kind: "text", stream: "stdout", payload: { text: line } }];
+	}
+	const env = parsed as Record<string, unknown>;
+	const type = typeof env.type === "string" ? env.type : "";
+	if (type === "thread.started" || type === "turn.started" || type === "turn.completed") {
+		return [{ kind: "state_change", stream: "system", payload: env }];
+	}
+	if (type === "turn.failed" || type === "error") {
+		return [{ kind: "state_change", stream: "system", payload: env }];
+	}
+	if (type.startsWith("item.")) return mapCodexItem(env);
+	return [{ kind: "telemetry", stream: "system", payload: env }];
+}
+
+function mapCodexItem(env: Record<string, unknown>): RuntimeEvent[] {
+	const item = env.item;
+	if (item === null || typeof item !== "object" || Array.isArray(item)) {
+		return [{ kind: "telemetry", stream: "system", payload: env }];
+	}
+	const value = item as Record<string, unknown>;
+	const itemType = typeof value.type === "string" ? value.type : "";
+	const text = typeof value.text === "string" ? value.text : undefined;
+	if (itemType === "agent_message" && text !== undefined) {
+		return [{ kind: "text", stream: "stdout", payload: { text, codex: env } }];
+	}
+	if (itemType === "reasoning" && text !== undefined) {
+		return [{ kind: "thinking", stream: "stdout", payload: { text, codex: env } }];
+	}
+	if (
+		itemType === "command_execution" ||
+		itemType === "file_change" ||
+		itemType === "mcp_tool_call"
+	) {
+		const status = typeof value.status === "string" ? value.status : "";
+		const completed = status === "completed" || status === "failed";
+		return [{ kind: completed ? "tool_result" : "tool_use", stream: "stdout", payload: env }];
+	}
+	return [{ kind: "telemetry", stream: "system", payload: env }];
+}
